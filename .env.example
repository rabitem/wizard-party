# Environment for the Next.js app. Copy to .env.local and fill in what you need.
# Everything is optional for local play: `npm run dev:all` runs the game with no values set.
# Features whose backing service is missing answer "unavailable" instead of failing.
# The game worker (party/) does not read this file; see .dev.vars.example.

# --- App URLs -------------------------------------------------------------------------------

# Public origin for metadata, sitemap, robots, profile and email links.
# Required in production. Default: the Vercel deployment URL on Vercel, http://localhost:3000 otherwise.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Imprint (legal notice) -----------------------------------------------------------------

# Operator shown on /imprint. Setting NEXT_PUBLIC_IMPRINT_NAME switches the whole imprint to
# these values (unset ones are left out). Unset: a placeholder operator. A production build
# needs NAME, STREET, CITY and EMAIL (src/config/deployment-requirements.ts).
NEXT_PUBLIC_IMPRINT_NAME=
NEXT_PUBLIC_IMPRINT_STREET=
NEXT_PUBLIC_IMPRINT_CITY=
NEXT_PUBLIC_IMPRINT_COUNTRY=
NEXT_PUBLIC_IMPRINT_EMAIL=
NEXT_PUBLIC_IMPRINT_WEBSITE=

# --- Realtime (game worker) -----------------------------------------------------------------

# Worker host the browser connects to (hostname[:port], no scheme). Required in production.
# Default: localhost:1999 (`npm run dev:party`); set it so server routes agree.
NEXT_PUBLIC_REALTIME_HOST=localhost:1999
# Server-only override of the host the API uses to check room membership for invites.
# Falls back to NEXT_PUBLIC_REALTIME_HOST.
REALTIME_HOST=
# Legacy name of NEXT_PUBLIC_REALTIME_HOST, still read as a fallback. Leave unset.
NEXT_PUBLIC_PARTYKIT_HOST=
# Signs tournament tickets and match results. Must equal the worker's TOURNAMENT_SECRET.
# Optional; tournaments show as unavailable without it (they also need DATABASE_URL).
TOURNAMENT_SECRET=

# --- Database -------------------------------------------------------------------------------

# Neon Postgres connection string (the HTTP driver needs Neon; a free project or branch works).
# Enables accounts, friends, tournaments, leaderboard and telemetry storage. Optional.
# Never point a development machine at the production database.
DATABASE_URL=
# Direct (non-pooled) connection used by `npm run db:migrate`. Falls back to DATABASE_URL.
DATABASE_URL_UNPOOLED=

# --- Auth (Better Auth) ---------------------------------------------------------------------

# Required once DATABASE_URL is set. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Auth base URL. Optional; defaults to http://localhost:3000 locally and the Vercel URL on Vercel.
BETTER_AUTH_URL=
# Social sign-in. A provider is offered as soon as both of its values are set. Optional.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Email (Resend) -------------------------------------------------------------------------

# Optional. Without it, emails (sign-in codes, friend requests) are logged to the server console.
RESEND_API_KEY=
# Sender address. Optional; defaults to the production noreply address.
EMAIL_FROM=
# Signs unsubscribe links. Optional; falls back to BETTER_AUTH_SECRET.
EMAIL_UNSUBSCRIBE_SECRET=

# --- Storage (Vercel Blob) ------------------------------------------------------------------

# Read by @vercel/blob for custom sound uploads. Optional; uploads fail without it.
BLOB_READ_WRITE_TOKEN=

# --- Rate limits and counters (Upstash Redis) -----------------------------------------------

# Either naming works (Vercel KV integration or Upstash directly). Optional; without Redis,
# friend presence, global stats and shared rate limits are skipped.
KV_REST_API_URL=
KV_REST_API_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Key for hashing IP-derived rate-limit subjects. Optional; derived from TELEMETRY_INGEST_SECRET,
# else random per instance.
RATE_LIMIT_KEY_SECRET=

# --- Telemetry ------------------------------------------------------------------------------

# Authenticates the worker's posts to /api/telemetry/ingest. Must equal the worker's value.
# Optional; the ingest endpoint answers 503 without it.
TELEMETRY_INGEST_SECRET=
# Bearer token Vercel Cron sends to /api/cron/telemetry-retention. Only needed on Vercel.
CRON_SECRET=

# --- Sandbox ---------------------------------------------------------------------------------

# 1 serves /sandbox/animations in production builds (`npm run e2e:build` sets it).
# Development builds and Vercel previews always serve it.
NEXT_PUBLIC_ENABLE_ANIMATION_SANDBOX=

# --- Test and tooling knobs (read from the shell by the test commands, not from this file) ---
# E2E_BASE_URL=           run the Playwright suites against a deployed URL instead of a local build
# E2E_PORT=3210           port of the local server Playwright starts
# E2E_WORKERS=2           Playwright worker count
# E2E_FULL_MATRIX=1       run every viewport of the playability matrix
# PERF_TARGET_FPS=120     frame rate the performance suite enforces (default 60)
# PROPERTY_GAMES=24       seed count of the random-games property test
# AUDIT_BROWSER=          path to a Chromium-based browser for `npm run audit:animations`

# --- Set by the platform; do not set by hand ---
# NODE_ENV, CI, VERCEL_ENV, VERCEL_URL, NEXT_PUBLIC_VERCEL_GIT_COMMIT_SHA
