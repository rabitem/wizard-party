# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# partykit
/.partykit/
/.wrangler/
/.dev.vars*
!/.dev.vars.example

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# IDE
.idea/
.vscode/
*.swp
*.swo

# Local worktrees (kept inside repo in this setup)
.worktrees/

# Claude / automation artifacts (keep out of git history)
.claude_settings.json
.claude/settings.local.json
.claude/worktrees/
.auto-claude-status
.auto-claude/
.codex/
.playwright-mcp/
GOAL*.md

.animation-audit/
# Playwright browser suites
/e2e-report/
/e2e-results/

# ESLint cache (npm run lint -- --cache)
.eslintcache
