{
  "name": "wizard-party",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "dev": "next dev",
    "dev:party": "wrangler dev",
    "dev:all": "concurrently \"npm run dev\" \"npm run dev:party\"",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:physics": "vitest run src/presentation/components/three/cardAnimationHelpers.test.ts src/presentation/components/three/cardAnimationHelpers.landing.test.ts src/presentation/components/three/played-card-rest-position.test.ts src/presentation/config/physics-utils.test.ts src/presentation/hooks/drag-to-play-math.test.ts src/presentation/utils/physics-boundary.test.ts src/presentation/utils/client-physics-state.test.ts",
    "build": "next build",
    "vercel-build": "node scripts/db-migrate.mjs --if-production && next build",
    "start": "next start",
    "lint": "eslint",
    "deploy:party": "wrangler deploy",
    "typecheck": "tsc --noEmit && tsc --project tsconfig.worker.json",
    "check:worker": "wrangler deploy --dry-run",
    "db:migrate": "node scripts/db-migrate.mjs",
    "telemetry:query": "node --env-file=.env.local scripts/telemetry-query.mjs",
    "audit:animations": "node scripts/animation-audit.mjs",
    "sounds:generate": "node scripts/generate-sounds.mjs",
    "e2e:build": "node scripts/e2e-build.mjs",
    "e2e": "playwright test",
    "e2e:perf": "playwright test e2e/performance.spec.ts --project=chromium --project=firefox --project=webkit --project=edge"
  },
  "dependencies": {
    "@better-auth/passkey": "^1.7.14",
    "@fontsource-variable/inter": "^5.3.0",
    "@neondatabase/serverless": "^1.2.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@react-three/postprocessing": "^3.2.2",
    "@react-three/rapier": "^2.2.0",
    "@upstash/redis": "^1.40.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/blob": "^2.8.2",
    "@vercel/functions": "^3.10.4",
    "@vercel/speed-insights": "^2.0.0",
    "better-auth": "^1.7.14",
    "lucide-react": "^1.64.0",
    "motion": "^14.7.1",
    "next": "^16.4.3",
    "partyserver": "^0.5.10",
    "partysocket": "^1.3.0",
    "pg": "^8.23.1",
    "postprocessing": "^6.39.5",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "three": "^0.186.1",
    "troika-three-text": "^0.52.5",
    "uuid": "^14.0.3",
    "web-vitals": "^6.2.3",
    "zod": "^4.6.7"
  },
  "overrides": {
    "zustand": "^5.0.0",
    "zod": "$zod"
  },
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || ^26.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261029.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitest/coverage-v8": "^5.0.5",
    "baseline-browser-mapping": "^2.11.34",
    "concurrently": "^10.0.6",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "eslint-config-next": "^16.4.3",
    "playwright-core": "^1.64.1",
    "tailwindcss": "^4.3.3",
    "typescript": "npm:@typescript/typescript6@^6.0.3",
    "vitest": "^5.0.5",
    "wrangler": "^4.155.0"
  },
  "type": "module"
}
